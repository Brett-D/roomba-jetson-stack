<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roomba_rs</name>
  <version>0.1.0</version>
  <description>Rust ports of the Roomba robot's ROS 2 nodes (floor_obstacles, ekf_inputs, vslam_watchdog, map_gap_filler, ignore_zones, roomba_driver, web_server, set_password, explorer, nav_coach, person_detector). Needs a Rust toolchain (rustup) and libclang-dev; cargo fetches rclrs. person_detector also needs TensorRT, CUDA and OpenCV dev files (JetPack).</description>
  <maintainer email="brett@brettsbox.com">Brett</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <!-- person_detector: native/person_shim.cpp links TensorRT (libnvinfer-dev, part of JetPack; no
       rosdep key), the CUDA runtime and OpenCV 4 -->
  <build_depend>cuda-toolkit</build_depend>
  <depend>libopencv-dev</depend>
  <depend>roomba_msgs</depend>
  <!-- vendor/isaac_ros_visual_slam_interfaces links its C type support libraries -->
  <depend>isaac_ros_visual_slam_interfaces</depend>
  <!-- web_server: the page it serves (share/roomba_web/www) and the system JPEG/PNG libraries -->
  <exec_depend>roomba_web</exec_depend>
  <depend>libjpeg</depend>
  <depend>libpng-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>